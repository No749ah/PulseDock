# ============================================================
# PulseDock — Environment Variables Example
# Copy to .env at the repo root and fill in your values.
# Never commit your real .env to version control.
# ============================================================

# ── API Server ──────────────────────────────────────────────
API_PORT=4321
APP_BASE_URL=http://localhost:1234

# ── JWT Secrets (generate with: openssl rand -hex 32) ───────
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-24-chars
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-min-24-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Auth & Registration ──────────────────────────────────────
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_ADMIN_EMAIL=admin@pulsedock.dev
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://pulsedock:pulsedock@localhost:5432/pulsedock?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Frontend ─────────────────────────────────────────────────
WEB_PORT=1234
NEXT_PUBLIC_API_BASE_URL=http://localhost:4321

# ── Mail (required for password reset, invites) ──────────────
MAIL_FROM=PulseDock <noreply@your-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ── Optional ─────────────────────────────────────────────────
LOG_LEVEL=info
RUN_MIGRATIONS_ON_STARTUP=false
RUN_RETENTION_DAYS=90           # Days of MonitorRun history to keep (cleanup runs daily at 03:00 UTC)
# SWAGGER_BASE_URL=https://api.your-domain.com
