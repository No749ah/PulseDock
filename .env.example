# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pulsedock:pulsedock@localhost:5432/pulsedock?schema=public"

# ─── JWT Secrets (generate with: openssl rand -hex 32) ───────────────────────
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-different-from-access-secret"

# ─── API Configuration ────────────────────────────────────────────────────────
API_PORT=4321
NODE_ENV=development          # development | production
LOG_LEVEL=info                # debug | info | warn | error
ALLOW_PUBLIC_REGISTRATION=false  # true = open signup, false = invite-only

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:1234"  # comma-separated in production

# ─── Web Frontend ────────────────────────────────────────────────────────────
WEB_PORT=1234
NEXT_PUBLIC_API_BASE_URL=""   # leave empty for same-host /api proxy

# ─── Internal API (Docker) ────────────────────────────────────────────────────
# INTERNAL_API_URL="http://api:4321"  # uncomment in Docker Compose

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PulseDock <noreply@example.com>"

# ─── Optional: GitHub Token ──────────────────────────────────────────────────
# GITHUB_TOKEN=""   # For higher GitHub API rate limits (version checks)

# ─── Optional: GitLab Token ──────────────────────────────────────────────────
# GITLAB_TOKEN=""   # Default token for GitLab version checks
