{
  "name": "@pulsedock/api",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=../../.env -e \"require('ts-node/register/transpile-only'); require('./src/main.ts');\"",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "../../node_modules/.bin/prisma generate --schema=../../prisma/schema.prisma 2>/dev/null || true",
    "test": "NODE_ENV=test NODE_PATH=../../node_modules ../../node_modules/.bin/vitest run --reporter=verbose",
    "test:typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "NODE_ENV=test NODE_PATH=../../node_modules ../../node_modules/.bin/vitest run --coverage",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "nodemailer": "^8.0.3",
    "path-to-regexp": "8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.10",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.1",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^4.1.1"
  }
}
