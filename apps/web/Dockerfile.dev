# PulseDock Web — Development Dockerfile
# Runs Next.js with HMR (next dev)
FROM node:22-alpine
WORKDIR /app

# Copy root package manifests
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/

# Install all deps (including devDependencies)
RUN npm ci --workspace=@pulsedock/web

WORKDIR /app/apps/web

# Expose Web port
EXPOSE 1234

# Start Next.js in development mode with HMR
CMD ["npx", "next", "dev", "--port", "1234"]
