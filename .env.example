# ─────────────────────────────────────────────────────────────
# PulseDock — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (Prisma format).
# For Docker Compose: use the service name as host.
DATABASE_URL=postgresql://pulsedock:changeme@localhost:5432/pulsedock?schema=public

# ── Redis ───────────────────────────────────────────────────
# Redis connection URL used for rate-limiting and caching.
REDIS_URL=redis://localhost:6379

# ── Ports ───────────────────────────────────────────────────
# Port the NestJS API server listens on.
API_PORT=4321

# Port the Next.js web server listens on.
WEB_PORT=1234

# ── Application URLs ────────────────────────────────────────
# Public-facing base URL of the web app (used in emails and reset links).
APP_BASE_URL=http://localhost:1234

# Alias used in some contexts (same value as APP_BASE_URL).
APP_URL=http://localhost:1234

# Public-facing URL of the web app (Next.js client-side).
NEXT_PUBLIC_APP_URL=http://localhost:1234

# Public-facing URL of the API (Next.js client-side).
# Leave unset to auto-detect:
#   - oc-dev-test.* domains → proxied through /api (Next.js rewrites)
#   - localhost              → http://localhost:4321 (direct)
# Set explicitly only if you run the API on a separate domain.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4321

# Internal API base URL (used by Next.js SSR — server-to-server).
# Leave unset to use http://localhost:{API_PORT}.
# API_BASE_URL=http://localhost:4321

# Additional CORS origins (comma-separated). APP_BASE_URL and WEB_URL are
# included automatically. Use this for extra origins (e.g. custom domains).
# CORS_ORIGINS=https://status.example.com,https://admin.example.com

# Swagger UI base URL override (optional).
# SWAGGER_BASE_URL=https://api.example.com

# App version shown in the UI (optional, auto-detected from package.json).
# NEXT_PUBLIC_APP_VERSION=1.0.2

# ── JWT Secrets ─────────────────────────────────────────────
# ⚠️  CHANGE THESE in production — use long random strings (32+ chars).
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-use-openssl-rand-hex-32-for-access
JWT_REFRESH_SECRET=change-me-use-openssl-rand-hex-32-for-refresh

# Token expiry durations (optional, defaults shown).
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# ── Admin Bootstrap ─────────────────────────────────────────
# Password for the default admin account created on first run.
# Only used if no users exist yet. Remove after first login.
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── Registration & Verification ────────────────────────────
# Set to "false" to disable public self-registration (invite-only mode).
ALLOW_PUBLIC_REGISTRATION=true

# Set to "true" to require email verification before login.
# Requires SMTP to be configured.
REQUIRE_EMAIL_VERIFICATION=false

# ── SMTP / Email ─────────────────────────────────────────────
# Required for: email verification, password reset, alert notifications.
# Leave unset to disable email features (alerts still work via webhook/Slack/etc).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM=PulseDock <noreply@example.com>

# ── External API Tokens (optional) ──────────────────────────
# GitHub token for higher rate limits on version checks (GIT_RELEASE monitors).
# Without this: 60 req/hr per IP. With token: 5000 req/hr.
# Scopes needed: none (public repos), or repo (private repos).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitLab token for GitLab CE/EE version checks (optional).
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Runtime ─────────────────────────────────────────────────
# Node environment. Use "production" in prod.
NODE_ENV=development

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Run Prisma migrations automatically on API startup (default: true).
# Set to "false" if you manage migrations manually.
# RUN_MIGRATIONS_ON_STARTUP=true

# ── Public URL (status page webhooks) ───────────────────────
# Used for status page subscriber emails and webhook payloads.
# Falls back to APP_BASE_URL if unset.
# PUBLIC_URL=https://status.example.com
