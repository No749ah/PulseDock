{
  "name": "pulsedock",
  "private": true,
  "version": "0.1.0",
  "description": "PulseDock - Version intelligence dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Use: npm run web | npm run api (or dev:web/dev:api)\"",
    "web": "npm run build -w @pulsedock/web && npm run start -w @pulsedock/web",
    "api": "npm run dev:api",
    "dev:web": "npm run dev -w @pulsedock/web",
    "dev:api": "npm run dev -w @pulsedock/api",
    "build": "npm run build -w @pulsedock/web && npm run build -w @pulsedock/api",
    "start:web": "bash ./scripts/start-web.sh",
    "start:api": "bash ./scripts/start-api.sh",
    "stop:web": "bash ./scripts/stop-web.sh",
    "stop:api": "bash ./scripts/stop-api.sh",
    "restart:web": "bash ./scripts/stop-web.sh && bash ./scripts/start-web.sh",
    "restart:api": "bash ./scripts/stop-api.sh && bash ./scripts/start-api.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "framer-motion": "^10.12.16",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  }
}
