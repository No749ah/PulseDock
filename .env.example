# PulseDock Environment Variables
# Copy this file to .env and fill in your values.
# Generate secrets with: openssl rand -hex 32

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pulsedock:pulsedock@localhost:5432/pulsedock?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Secrets (REQUIRED — generate unique values) ─────────────────────────
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-different-from-access-secret"
JWT_ACCESS_EXPIRES="15m"      # e.g. 15m, 1h
JWT_REFRESH_EXPIRES="30d"     # e.g. 7d, 30d

# ─── Application URLs ────────────────────────────────────────────────────────
APP_URL="http://localhost:1234"        # Public URL of the web frontend
APP_BASE_URL="http://localhost:1234"   # Alias — used in email links
PUBLIC_URL="http://localhost:1234"     # Alias — used in status page embeds
WEB_URL="http://localhost:1234"        # Alias — used in internal services

# ─── API Configuration ────────────────────────────────────────────────────────
API_PORT=4321
NODE_ENV=development          # development | production
LOG_LEVEL=info                # debug | info | warn | error
ALLOW_PUBLIC_REGISTRATION=false  # true = open signup, false = invite-only
RUN_MIGRATIONS_ON_STARTUP=false  # true = run prisma migrate deploy on API start

# ─── Initial Admin Account ───────────────────────────────────────────────────
# DEFAULT_ADMIN_PASSWORD=""   # Preset password for the first admin account (setup page)

# ─── Email Verification ──────────────────────────────────────────────────────
REQUIRE_EMAIL_VERIFICATION=false  # true = users must verify email before login

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:1234"  # comma-separated list of allowed origins

# ─── Web Frontend ────────────────────────────────────────────────────────────
WEB_PORT=1234
NEXT_PUBLIC_API_BASE_URL=""   # Leave empty for same-host /api proxy (recommended)

# ─── Swagger / API Docs ──────────────────────────────────────────────────────
# SWAGGER_BASE_URL=""         # Override base URL for Swagger UI (useful behind proxy)

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PulseDock <noreply@example.com>"
MAIL_FROM="PulseDock <noreply@example.com>"  # Alias for SMTP_FROM

# ─── Optional: GitHub Token ──────────────────────────────────────────────────
# GITHUB_TOKEN=""   # Personal access token for higher GitHub API rate limits
                    # (unauthenticated: 60 req/hr, authenticated: 5000 req/hr)
                    # Needed if you track many GitHub-hosted tools

# ─── Optional: GitLab Token ──────────────────────────────────────────────────
# GITLAB_TOKEN=""   # Default token for GitLab version checks (self-hosted or gitlab.com)
