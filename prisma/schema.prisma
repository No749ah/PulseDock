generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum MonitorType {
  HTTP
  GIT_RELEASE
  DOCKER_IMAGE
  TCP
  SSL_CERT
  HEARTBEAT
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  role               Role           @default(user)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  emailVerified      Boolean        @default(false)
  failedLoginCount   Int            @default(0)
  lockedUntil        DateTime?
  totpSecret         String?
  totpEnabled        Boolean        @default(false)
  totpRecoveryCodes  String?
  displayName        String?
  timezone           String?        @default("UTC")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sessions        Session[]
  folders         Folder[]
  monitors        Monitor[]
  monitorRuns     MonitorRun[]
  alertChannels   AlertChannel[]
  sentInvites     InviteToken[]    @relation("invitedBy")
  actorAuditLogs  AuditLog[]       @relation("audit_actor")
  targetAuditLogs AuditLog[]       @relation("audit_target")
  apiKeys                 ApiKey[]
  statusPages             PublicStatusPage[]
  tags                    Tag[]
  notificationPreference  NotificationPreference?
  maintenanceWindows      MaintenanceWindow[]
  incidents               Incident[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors Monitor[]
}

model Monitor {
  id            String      @id @default(cuid())
  userId        String
  folderId      String?
  name          String
  type          MonitorType
  target        String
  intervalSec   Int         @default(60)
  timeoutMs     Int         @default(5000)
  enabled       Boolean     @default(true)
  configJson    Json?
  createdAt     DateTime    @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  runs          MonitorRun[]
  monitorAlerts MonitorAlert[]
  monitorTags   MonitorTag[]
  maintenanceWindows MaintenanceWindowMonitor[]
  incidentMonitors   IncidentMonitor[]

  @@index([userId])
  @@index([enabled])
  @@index([userId, enabled])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorTags MonitorTag[]

  @@unique([userId, name])
  @@index([userId])
}

model MonitorTag {
  monitorId String
  tagId     String

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([monitorId, tagId])
}

model MonitorRun {
  id        String   @id @default(cuid())
  monitorId String
  userId    String
  level     String
  ok        Boolean
  status    Int
  latencyMs Int?
  message   String
  checkedAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@index([userId, checkedAt])
  @@index([checkedAt])
}

model AlertChannel {
  id         String   @id @default(cuid())
  userId     String
  name       String
  type       String
  configJson Json
  createdAt  DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorAlerts MonitorAlert[]
}

model MonitorAlert {
  monitorId      String
  alertChannelId String

  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  alertChannel AlertChannel @relation(fields: [alertChannelId], references: [id], onDelete: Cascade)

  @@id([monitorId, alertChannelId])
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String
  role        Role      @default(user)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model AuditLog {
  id           String    @id @default(cuid())
  action       String
  actorUserId  String?
  targetUserId String?
  metaJson     Json?
  createdAt    DateTime  @default(now())

  actorUser  User? @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("audit_target", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([token])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model PublicStatusPage {
  id           String   @id @default(cuid())
  userId       String
  slug         String   @unique
  title        String
  description  String?
  isPublished  Boolean  @default(false)
  passwordHash String?
  layout       Json     @default("{\"widgets\":[]}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([isPublished])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  notifyOnDown      Boolean  @default(true)
  notifyOnRecovery  Boolean  @default(true)
  notifyOnDegraded  Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   Int      @default(22)
  quietHoursEnd     Int      @default(8)
  frequency         String   @default("instant")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MaintenanceWindow {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors MaintenanceWindowMonitor[]

  @@index([userId])
  @@index([startsAt, endsAt])
}

model MaintenanceWindowMonitor {
  windowId  String
  monitorId String

  window  MaintenanceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  monitor Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([windowId, monitorId])
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Incident {
  id          String           @id @default(cuid())
  userId      String
  title       String
  description String?
  status      IncidentStatus   @default(INVESTIGATING)
  severity    IncidentSeverity @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  updates  IncidentUpdate[]
  monitors IncidentMonitor[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model IncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String
  body       String
  status     IncidentStatus
  createdAt  DateTime       @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentMonitor {
  incidentId String
  monitorId  String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  monitor  Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([incidentId, monitorId])
}
