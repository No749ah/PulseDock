# PulseDock .env.example
# Copy this to .env and modify as needed.

# API server
API_PORT=4000
# Web server
WEB_PORT=3000

# Database (Postgres)
DATABASE_URL=postgresql://pulsedock:password@localhost:5432/pulsedock

# Redis
REDIS_URL=redis://localhost:6379

# JWT / Security (example values, change in production)
JWT_SECRET=change-me

# Public web build: ensure the web app knows which API host to use in the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Other example envs
#PUBLIC_SLUG=your-public-status-page-slug
