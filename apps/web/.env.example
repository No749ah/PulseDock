# ─────────────────────────────────────────────────────────────────────────────
# PulseDock Web — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit your actual .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL — the full URL of the PulseDock API server
# Used both server-side (SSR) and client-side (browser)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4321"

# App version shown in the UI (optional — set by CI/CD)
NEXT_PUBLIC_APP_VERSION=""

# Node environment
NODE_ENV="production"

# Port for the Next.js dev server (default: 3000)
# PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# White-label / Branding Configuration (all optional)
# Override to deploy PulseDock under your own brand.
# ─────────────────────────────────────────────────────────────────────────────

# Application name shown in nav, titles, emails (default: "PulseDock")
# NEXT_PUBLIC_APP_NAME="AcmeDock"

# Short description for meta tags (default: "Version Intelligence & Uptime Monitoring")
# NEXT_PUBLIC_APP_DESCRIPTION="Acme Monitoring Platform"

# Full description for SEO (default: built-in PulseDock description)
# NEXT_PUBLIC_APP_FULL_DESCRIPTION="Monitor your Acme services for version updates and uptime."

# Custom logo URL — replaces the icon+name in nav and login (default: built-in SVG)
# NEXT_PUBLIC_APP_LOGO_URL="https://example.com/logo.svg"

# Custom favicon URL — replaces /favicon.svg (default: built-in)
# NEXT_PUBLIC_APP_FAVICON_URL="https://example.com/favicon.ico"

# Primary accent color (hex) — overrides --color-accent CSS variable (default: "#58a6ff")
# NEXT_PUBLIC_APP_ACCENT_COLOR="#0070f3"

# Canonical URL for meta tags and JSON-LD (default: "https://oc-dev-test.no749ah.com")
# NEXT_PUBLIC_APP_URL="https://status.acme.com"

# OG image URL for social sharing (default: {APP_URL}/og-image.png)
# NEXT_PUBLIC_APP_OG_IMAGE_URL="https://example.com/og-image.png"

# Hide "Powered by PulseDock" attribution in footer (default: false)
# NEXT_PUBLIC_HIDE_BRANDING="true"

# GitHub repository URL for docs/contributing links (default: PulseDock repo)
# NEXT_PUBLIC_GITHUB_URL="https://github.com/acme/acmedock"
