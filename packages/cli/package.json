{
  "name": "@pulsedock/cli",
  "version": "1.1.0",
  "description": "PulseDock CLI — one-shot HTTP checker and monitor management tool",
  "keywords": [
    "pulsedock",
    "uptime",
    "monitor",
    "cli"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pulsedock": "./bin/pulsedock.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.chmodSync('bin/pulsedock.js',0o755);\"",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
