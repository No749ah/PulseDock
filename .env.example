# API
API_PORT=4000
APP_BASE_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-24
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-min-24
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_ADMIN_EMAIL=admin@pulsedock.dev
DEFAULT_ADMIN_PASSWORD=admin123

# Mail (required in production/staging)
MAIL_FROM=PulseDock <noreply@your-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Database (enterprise target)
DATABASE_URL=postgresql://pulsedock:pulsedock@localhost:5432/pulsedock?schema=public
