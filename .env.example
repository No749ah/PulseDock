# Workspace-level example environment variables for PulseDock development
# Copy this to .env at the repo root or use project-specific .env files in projects/PulseDock/

# Frontend dev port
WEB_PORT=3000
# API dev port
API_PORT=4000
# Database
DATABASE_URL=postgresql://pulsedock:pulsedock@localhost:5432/pulsedock
# Redis
REDIS_URL=redis://127.0.0.1:6379
# Admin user (dev only)
DEFAULT_ADMIN_EMAIL=admin@pulsedock.dev
DEFAULT_ADMIN_PASSWORD=admin123

# Git / CI
GIT_REMOTE=git@github.com:no749ah/PulseDock.git
CI=true

# Local dev conveniences
DEV_SKIP_SEED=false

# Logging
LOG_LEVEL=info

# Note: keep secrets out of version control. Use .env.local or secret managers in production.
=======
