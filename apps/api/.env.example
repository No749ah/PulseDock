# ─────────────────────────────────────────────────────────────────────────────
# PulseDock API — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pulsedock"

# Redis (session store + cache)
REDIS_URL="redis://localhost:6379"

# JWT Auth — Access Token
JWT_ACCESS_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRES="15m"

# JWT Auth — Refresh Token
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string-at-least-32-chars"
JWT_REFRESH_EXPIRES="7d"

# App
NODE_ENV="production"
API_PORT=4321

# URLs (used for CORS, links in emails, etc.)
APP_BASE_URL="https://yourdomain.com"
APP_URL="https://yourdomain.com"
PUBLIC_URL="https://yourdomain.com"
WEB_URL="https://yourdomain.com"

# Swagger UI base (leave empty for default)
SWAGGER_BASE_URL=""

# Email (SMTP) — required for email alerts and password reset
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
MAIL_FROM="PulseDock <noreply@example.com>"

# Features / Registration
# Set to "true" to allow anyone to register (open registration)
ALLOW_PUBLIC_REGISTRATION=true
# Set to "true" to require email verification on signup
REQUIRE_EMAIL_VERIFICATION=false

# Admin
# Initial admin account password (used on first startup only)
DEFAULT_ADMIN_PASSWORD="change-me-immediately"

# Migrations
# Set to "true" to auto-run Prisma migrations on startup (not recommended for production)
RUN_MIGRATIONS_ON_STARTUP=false

# Optional: GitHub/GitLab tokens for higher API rate limits on version monitors
# These are optional — monitors work without them, but rate limits apply
GITHUB_TOKEN=""
GITLAB_TOKEN=""

# External Plugin Directory
# Path to a directory containing user-installable check plugins (*.plugin.js files).
# Plugins are loaded at API startup. Leave empty to disable external plugins.
# PLUGIN_DIR="./plugins"

# ─────────────────────────────────────────────────────────────────────────────
# White-label / Branding (API-side — used in email subjects and bodies)
# ─────────────────────────────────────────────────────────────────────────────

# App name shown in email subjects and bodies (default: "PulseDock")
# APP_NAME="AcmeDock"

# App URL used in email links (default: "https://oc-dev-test.no749ah.com")
# APP_URL="https://status.acme.com"

# GitHub/repository URL used in email footer (default: PulseDock repo)
# GITHUB_URL="https://github.com/acme/acmedock"
